<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View afip_responsability_data View Tree -->
    <record id="view_afip_responsability_data_tree" model="ir.ui.view">
        <field name="name">view.afip_responsability_data.tree</field>
        <field name="model">afip_responsability_data</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View afip_responsability_data form -->
    <record id="view_afip_responsability_data_form" model="ir.ui.view">
        <field name="name">view.afip_responsability_data.form</field>
        <field name="model">afip_responsability_data</field>
        <field name="arch" type="xml">
            <form string="Afip_responsability_data">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View afip_responsability_data search -->
    <record id="view_afip_responsability_data_search" model="ir.ui.view">
        <field name="name">view.afip_responsability_data.search</field>
        <field name="model">afip_responsability_data</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action afip_responsability_data -->
    <record id="action_afip_responsability_data" model="ir.actions.act_window">
        <field name="name">Afip_responsability_data</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">afip_responsability_data</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Afip_responsability_data.
            </p>
        </field>
    </record>

</odoo>
